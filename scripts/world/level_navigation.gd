class_name LevelNavigation
extends NavigationRegion3D
## The level's walkable NavigationMesh (BUILD_PLAN step 12), baked at load from the
## StaticBody3D colliders under `source` (the level's Boxes), synchronously on the main
## thread, so a Gnawer can path around walls the first time the map syncs.
##
## Magewar reference (scenes/levels/landfill_tutorial.tscn, read-only): a
## NavigationRegion3D wraps the landfill's Ground/TrashPiles CSG, but it has no
## NavigationMesh and is never baked (its enemies never move). Ours is generated by
## tools/toml_to_scene.py next to Boxes (Boxes keeps its path) and baked here.
##
## The NavigationServer syncs maps once per physics frame (asynchronously), so paths
## exist only from about the 3rd physics frame after the bake (`map_ready()`); until then
## the Gnawer steers straight at its target.

signal baked(region: LevelNavigation)

## The node whose StaticBody3D children are parsed (ROOT_NODE_CHILDREN mode, not a
## global group, so test worlds and levels never bake each other's geometry).
@export var source: NodePath = ^"../Boxes"
@export var bake_on_ready := true

var bakes := 0
var _bake_iteration := -1  ## step 47: the map iteration a re-bake started on


## A NavigationMesh tuned for the Gnawer (Magewar's rat-sized rusher): radius 0.5 m
## (its 0.5 x 0.8 body's half diagonal 0.47, rounded up), 0.5 m tall, 0.25 m climb, 45°.
## Cells match project.godot navigation/3d/default_cell_size / default_cell_height.
static func make_mesh() -> NavigationMesh:
	var nm := NavigationMesh.new()
	nm.geometry_parsed_geometry_type = NavigationMesh.PARSED_GEOMETRY_STATIC_COLLIDERS
	nm.geometry_source_geometry_mode = NavigationMesh.SOURCE_GEOMETRY_ROOT_NODE_CHILDREN
	nm.geometry_collision_mask = 1
	nm.cell_size = 0.1
	nm.cell_height = 0.05
	nm.agent_radius = 0.5
	nm.agent_height = 0.5
	nm.agent_max_climb = 0.25
	nm.agent_max_slope = 45.0
	return nm


func _ready() -> void:
	if bake_on_ready:
		bake_now()


## Parses `source` and bakes into navigation_mesh (creating one if missing); returns
## the polygon count.
func bake_now() -> int:
	var root := get_node_or_null(source)
	if root == null:
		push_error("LevelNavigation %s: no source node %s" % [name, source])
		return 0
	var nm := navigation_mesh if navigation_mesh != null else make_mesh()
	var data := NavigationMeshSourceGeometryData3D.new()
	NavigationServer3D.parse_source_geometry_data(nm, data, root)
	NavigationServer3D.bake_from_source_geometry_data(nm, data)
	navigation_mesh = null  # re-assign so the region pushes the new polygons
	navigation_mesh = nm
	var m := get_navigation_map() if is_inside_tree() else RID()
	_bake_iteration = NavigationServer3D.map_get_iteration_id(m) if m.is_valid() else -1
	bakes += 1
	baked.emit(self)
	return nm.get_polygon_count()


## True once the navigation map has synced with this region's baked polygons on it. The
## server builds regions on worker threads: a few frames for a test room, ~35 physics
## frames for the Midden's 244 polygons (measured); until then paths come back empty and
## the Gnawer steers straight.
func map_ready() -> bool:
	if navigation_mesh == null or navigation_mesh.get_polygon_count() == 0:
		return false
	var map := get_navigation_map()
	if not map.is_valid() or NavigationServer3D.map_get_iteration_id(map) == 0:
		return false  # querying before the first sync logs an error
	if NavigationServer3D.map_get_iteration_id(map) <= _bake_iteration:
		return false  # step 47: a re-bake not yet on the map (old polygons still answer)
	var verts := navigation_mesh.get_vertices()
	var poly := navigation_mesh.get_polygon(0)
	var c := Vector3.ZERO
	for v in poly:
		c += verts[v]
	var p := global_transform * (c / poly.size())  # the polygon's centre: only this region owns it
	var owner_rid := NavigationServer3D.map_get_closest_point_owner(map, p)
	return owner_rid == get_rid()
