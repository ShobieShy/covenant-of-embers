; Engine configuration file.
; Covenant of Embers – Godot 4 project (ADR-0002).

config_version=5

[application]

config/name="Covenant of Embers"
config/description="Original open-source co-op loot FPS (Magewar-style staffs and wands)."
run/main_scene="res://scenes/menu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="covenant-of-embers"
config/version="0.3.2-prealpha"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/branding/icon.png"
config/windows_native_icon="res://assets/branding/icon.ico"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/dpi/allow_hidpi=true

